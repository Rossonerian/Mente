{
  "name": "mente",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:export": "expo export --platform web",
    "supabase:start": "npx supabase start",
    "supabase:status": "npx supabase status",
    "supabase:stop": "npx supabase stop",
    "db:migrate": "cd backend && alembic upgrade head",
    "backend:test": "cd backend && python -m pytest",
    "backend:lint": "cd backend && ruff check . && mypy app",
    "frontend:check": "npm run typecheck && npm run lint && npm test -- --runInBand",
    "verify": "npm run frontend:check && npm run backend:test && npm run backend:lint",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "2.115.0",
    "@tamagui/config": "^2.7.7",
    "@tanstack/react-query": "5.102.8",
    "expo": "~57.0.21",
    "expo-blur": "~57.0.2",
    "expo-font": "~57.0.3",
    "expo-glass-effect": "~57.0.2",
    "expo-linear-gradient": "~57.0.1",
    "expo-secure-store": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.87.0",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-url-polyfill": "4.0.0",
    "react-native-web": "^0.21.0",
    "tamagui": "^2.7.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.35.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/src/test/setup.ts"
    ]
  }
}
