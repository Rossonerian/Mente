ENVIRONMENT=development
DATABASE_URL=sqlite:///./mente.db
AUTO_CREATE_TABLES=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=15000

# The API validates caregiver Supabase JWTs through this project's JWKS endpoint.
# Use an HTTPS project URL and the actual audience configured for the project.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# Generate a long random value before any shared deployment. It belongs only on the server.
CALL_BOT_API_KEY=replace-with-a-different-long-random-key

# Development only. Production requires explicit HTTPS origins; never use * with credentials.
CORS_ORIGINS=http://localhost:19006,http://localhost:8081,http://localhost:3000
JOIN_CODE_MINUTES=15
PATIENT_DEVICE_TOKEN_DAYS=30
AUTH_ATTEMPTS_PER_MINUTE=10
JOIN_ATTEMPTS_PER_MINUTE=10

# Optional local/test fixture only. This code is intentionally not accepted in
# production and must target one local patient created through caregiver setup.
# DEVELOPMENT_ADMIN_CODE=482916
# DEVELOPMENT_PATIENT_ID=replace-with-local-patient-id
