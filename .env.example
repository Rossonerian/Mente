# Public Expo configuration only. Do not place service-role, database, Twilio, or patient-device secrets here.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/v1
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Explicitly opt in only for local UI demonstration data. Leave false for live local integration.
EXPO_PUBLIC_MENTE_MOCK_MODE=false
